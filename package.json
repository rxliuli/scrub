{
  "name": "scrub",
  "description": "One-click clear all site data (cookies, storage, cache) for the current website.",
  "private": true,
  "version": "0.0.21",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "build:safari": "wxt build -b safari",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "is-ci && pnpm exec playwright install || echo 'Not in CI' && vitest run",
    "init-project": "vite-node lib/build/init.ts"
  },
  "dependencies": {
    "@extport/sdk": "^0.0.10",
    "@tailwindcss/vite": "^4.3.5",
    "@webext-core/messaging": "^4.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.74.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@extport/wxt": "^0.0.13",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.1",
    "@wxt-dev/module-react": "^1.2.2",
    "is-ci": "^4.1.0",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wxt": "^0.21.5",
    "zx": "^8.8.5"
  },
  "packageManager": "pnpm@12.21.0+sha512.Zv2CeO4ok1zpUXktNDZ/869cQyonVkRYIwKVM4NbjaUpu+C+UTCv1W7QcT+4eJ5Hutgtk71a4v5UsVVi1idu8A=="
